<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Main application database -->
    <add name="DefaultConnection" connectionString="Server=.;Database=BAOrderScraper;Trusted_Connection=true;TrustServerCertificate=true;" providerName="System.Data.SqlClient" />
    <!-- Syspro database for inventory lookups -->
    <add name="SysproDatabase" connectionString="Server=SysproServer;Database=SysproCompanyDB;Trusted_Connection=true;TrustServerCertificate=true;" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Application Settings -->
    <add key="retryCount" value="3" />
    
    <!-- LEGACY SELENIUM SETTINGS (for Toyota import only) -->
    <add key="EdgeDriverPath" value="C:\EdgeDriver\msedgedriver.exe" />
    <add key="PublishPath" value="C:\Apps\BA.OrderScraper" />

    <!-- LEGACY WEB PORTAL SETTINGS (no longer used for Syspro orders) -->
    <add key="SysproAvantiPortalUrl" value="https://your-syspro-portal.com/avanti" />
    <add key="SysproAvantiPortalUsername" value="your-username" />
    <add key="SysproAvantiPortalPassword" value="your-password" />
    <add key="SysproAvantiPortalCompany" value="COMPANY01" />
    <add key="SysproAvantiPortalCompanyPassword" value="company-password" />

    <!-- NEW SYSPRO API SETTINGS -->
    <!-- 
    Configure these settings to connect to your Syspro web service:
    1. Install Syspro Web Services on your Syspro server
    2. Update the base URL to point to your web service endpoint
    3. Use the same credentials as portal (or create dedicated API user)
    -->
    <add key="SysproApiBaseUrl" value="http://your-syspro-server:8080/sysprowebapi" />
    <add key="SysproApiUsername" value="api-user" />
    <add key="SysproApiPassword" value="api-password" />
    <add key="SysproApiCompany" value="COMPANY01" />
    <add key="SysproApiCompanyPassword" value="company-password" />
    
    <!-- API Connection Settings -->
    <add key="SysproApiTimeout" value="300" />
    <add key="SysproApiRetryCount" value="3" />
    
    <!-- Business Object Settings -->
    <add key="SysproSalesOrderBO" value="SORTOI" />
    <add key="SysproInventoryQueryBO" value="INVQRY" />
    
    <!-- Default Values -->
    <add key="DefaultCustomer" value="TOY020" />
    <add key="DefaultUnitOfMeasure" value="EA" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.EntityFrameworkCore" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.5.0" newVersion="9.0.5.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>